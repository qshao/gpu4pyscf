# Choose only generic targets accepted by the selected CUDA compiler.
# Architecture-specific variants such as sm_100a are deliberately not defaults.
function(gpu4pyscf_default_cuda_architectures output compiler_codes)
  string(REPLACE "\n" ";" compiler_codes "${compiler_codes}")
  set(supported "")
  foreach(code IN LISTS compiler_codes)
    string(STRIP "${code}" code)
    if(code MATCHES "^sm_([0-9]+)$")
      list(APPEND supported "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  set(architectures "")
  foreach(arch 70 75 80 90 100 120 121)
    if(arch STREQUAL "75" AND "70" IN_LIST supported)
      continue()
    endif()
    if(arch IN_LIST supported)
      list(APPEND architectures "${arch}-real")
      set(highest "${arch}")
    endif()
  endforeach()
  if(NOT architectures)
    message(FATAL_ERROR "No supported GPU4PySCF CUDA targets found. Set CMAKE_CUDA_ARCHITECTURES explicitly.")
  endif()
  # A PTX image allows JIT compilation on newer compatible devices.
  list(APPEND architectures "${highest}-virtual")
  set(${output} "${architectures}" PARENT_SCOPE)
endfunction()

macro(gpu4pyscf_select_cuda_architectures)
  if(DEFINED CUDA_ARCHITECTURES)
    set(CMAKE_CUDA_ARCHITECTURES "${CUDA_ARCHITECTURES}")
  elseif(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
    if(DEFINED ENV{CUDAARCHS} AND NOT "$ENV{CUDAARCHS}" STREQUAL "")
      set(CMAKE_CUDA_ARCHITECTURES "$ENV{CUDAARCHS}")
    else()
      include(CheckLanguage)
      check_language(CUDA)
      if(NOT CMAKE_CUDA_COMPILER)
        message(FATAL_ERROR "A CUDA compiler is required to build GPU4PySCF.")
      endif()
      execute_process(COMMAND "${CMAKE_CUDA_COMPILER}" --list-gpu-code
        OUTPUT_VARIABLE gpu4pyscf_cuda_codes
        ERROR_VARIABLE gpu4pyscf_cuda_error
        RESULT_VARIABLE gpu4pyscf_cuda_status)
      if(NOT gpu4pyscf_cuda_status EQUAL 0)
        message(FATAL_ERROR "Cannot query CUDA compiler targets: ${gpu4pyscf_cuda_error}. Set CMAKE_CUDA_ARCHITECTURES explicitly for compilers without nvcc --list-gpu-code support.")
      endif()
      gpu4pyscf_default_cuda_architectures(CMAKE_CUDA_ARCHITECTURES "${gpu4pyscf_cuda_codes}")
    endif()
  endif()
endmacro()
